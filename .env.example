# Supabase — em Project Settings > API no teu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TMDB — cria uma conta em https://www.themoviedb.org/settings/api e usa o "API Read Access Token" (v4 auth)
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=eyIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AniList e Open Library não precisam de chave — as suas APIs são públicas.
